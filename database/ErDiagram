# Database Design

This document contains the ERD for the IT Help Desk & Ticketing Management System.

## ERD Diagram

```mermaid
erDiagram
    direction TB

    Role ||--o{ User : has

    User ||--o{ Ticket : creates
    User ||--o{ Ticket : assigned_to

    Category ||--o{ Ticket : classifies
    Priority ||--o{ Ticket : defines
    Status ||--o{ Ticket : tracks

    Ticket ||--o{ TicketComment : has
    User ||--o{ TicketComment : writes

    Ticket ||--o{ TicketAttachment : has
    User ||--o{ TicketAttachment : uploads

    User ||--o{ Notification : receives
    Ticket ||--o{ Notification : triggers

    User ||--o{ ActivityLog : performs
    Ticket ||--o{ ActivityLog : records

    Role {
        int RoleId PK
        string RoleName
        string Description
    }

    User {
        int UserId PK
        int RoleId FK
        string FullName
        string Email
        string PasswordHash
        string PhoneNumber
        string Department
        boolean IsActive
        datetime CreatedAt
        datetime UpdatedAt
    }

    Ticket {
        int TicketId PK
        string TicketReference
        int CreatedByUserId FK
        int AssignedToUserId FK
        int CategoryId FK
        int PriorityId FK
        int StatusId FK
        string Title
        string Description
        datetime CreatedAt
        datetime UpdatedAt
        datetime ResolvedAt
        datetime ClosedAt
    }

    Category {
        int CategoryId PK
        string CategoryName
        string Description
        boolean IsActive
    }

    Priority {
        int PriorityId PK
        string PriorityName
        string Description
        int SortOrder
    }

    Status {
        int StatusId PK
        string StatusName
        string Description
        int SortOrder
    }

    TicketComment {
        int TicketCommentId PK
        int TicketId FK
        int UserId FK
        string CommentText
        boolean IsInternal
        datetime CreatedAt
    }

    TicketAttachment {
        int TicketAttachmentId PK
        int TicketId FK
        int UploadedByUserId FK
        string FileName
        string FilePath
        string FileType
        int FileSize
        datetime UploadedAt
    }

    Notification {
        int NotificationId PK
        int UserId FK
        int TicketId FK
        string Title
        string Message
        boolean IsRead
        datetime CreatedAt
        datetime ReadAt
    }

    ActivityLog {
        int ActivityLogId PK
        int UserId FK
        int TicketId FK
        string Action
        string Description
        datetime CreatedAt
    }
```
